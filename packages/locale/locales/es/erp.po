msgid "<0>Add a supplier part</0> for this item to set a preferred supplier."
msgstr ""
"Añadir una parte suministradora <0></0> para establecer un proveedor "
"preferente."

msgid ""
"<0>delete</0> lets you delete rows. <1>delete</1> will match all rows by "
"default, so remember to specify your filters!"
msgstr ""
"<0>delete</0> te permite eliminar filas. <1>delete</1> coincidirá con todas "
"las filas de forma predeterminada, ¡así que recuerda especificar tus "
"filtros!"

msgid ""
"<0>insert</0> lets you insert into your tables. You can also insert in bulk "
"and do UPSERT."
msgstr ""
"<0>insert</0> te permite insertar en tus tablas. También puedes insertar en "
"lote y hacer UPSERT."

msgid "<0>insert</0> will also return the replaced values for UPSERT."
msgstr "<0>insert</0> también devolverá los valores reemplazados para UPSERT."

msgid ""
"<0>update</0> lets you update rows. <1>update</1> will match all rows by "
"default. You can update specific rows using horizontal filters, e.g. "
"<2>eq</2>, <3>lt</3>, and <4>is</4>."
msgstr ""
"<0>update</0> te permite actualizar filas. <1>update</1> coincidirá con "
"todas las filas de forma predeterminada. Puedes actualizar filas específicas"
" usando filtros horizontales, por ejemplo <2>eq</2>, <3>lt</3> e <4>is</4>."

msgid "<0>update</0> will also return the replaced values for UPDATE."
msgstr "<0>update</0> también devolverá los valores reemplazados para UPDATE."

