msgid ""
"\"{storageUnitName}\" has {childCount} direct nested storage units. Deleting"
" it will also delete them and anything underneath them. This cannot be "
"undone."
msgstr ""
"\"{storageUnitName}\" tiene {childCount} unidades de almacenamiento anidadas"
