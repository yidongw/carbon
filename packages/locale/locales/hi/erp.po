msgstr "1% 10 नेट 30"

msgid "2% 10 Net 30"
msgstr "2% 10 नेट 30"

msgid "3D Model"
msgstr "3D मॉडल"

msgid "5 User Minimum"
msgstr "5 उपयोगकर्ता न्यूनतम"

