msgid "You're on the free plan. Upgrade to unlock more seats and features."
msgstr "Вы используете бесплатный план. Перейдите на платный, чтобы разблокировать больше мест и функций."

msgid "You've been clocked in for {hoursElapsed} hours. Did you forget to clock out?"
msgstr "Вы отметились на работу {hoursElapsed} часов назад. Вы забыли отметиться на выход?"

msgid "Your account is not active"
msgstr "Ваша учетная запись не активна"

msgid "Your annual license expires in {left} days. Renew now."
msgstr "Ваша годовая лицензия истекает через {left} дней. Продлите сейчас."

msgid "Your annual license has expired. Renew now to restore access."
msgstr "Ваша годовая лицензия истекла. Продлите сейчас, чтобы восстановить доступ."

msgid "Your company is on the free plan (read-only). Upgrade to make changes."
msgstr "Ваша компания использует бесплатный тариф (только чтение). Перейдите на платный тариф, чтобы вносить изменения."

msgid "Your Console PIN"
msgstr "Ваш PIN консоли"

msgid "Your demo is ready — explore every module!"
msgstr "Ваша демонстрация готова — изучите каждый модуль!"

msgid "Your Email"
msgstr "Ваша электронная почта"

msgid "Your invitation is invalid or has already been accepted. Please contact support if you believe this is an error."
msgstr "Ваше приглашение недействительно или уже было принято. Пожалуйста, свяжитесь со службой поддержки, если вы считаете, что это ошибка."

msgid "Your Name"
msgstr "Ваше имя"

msgid "Your request has been submitted."
msgstr "Ваш запрос был отправлен."

