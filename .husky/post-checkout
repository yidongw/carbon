#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

# $3 is 1 for branch checkout (including `git worktree add`), 0 for file checkout.
[ "$3" = "1" ] || exit 0

# Find the primary worktree (first entry in `git worktree list`).
main=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')

has_required_bins() {
  [ -x "$1/node_modules/.bin/lint-staged" ] &&
    [ -x "$1/node_modules/.bin/tsx" ] &&
    [ -x "$1/node_modules/.bin/lingui" ]
}

# Ensure the primary worktree has a complete install with the binaries hooks need.
if ! has_required_bins "$main"; then
  echo "→ node_modules incomplete in $main — running pnpm install..."
  (cd "$main" && pnpm install --frozen-lockfile)
fi

# If this worktree already has a complete install (real install or symlink), keep it.
if has_required_bins "."; then
  exit 0
fi

# Replace incomplete local node_modules with a symlink to the primary worktree.
if [ -e "node_modules" ] && [ ! -L "node_modules" ]; then
  rm -rf node_modules
fi

# If a stale symlink is present, remove it before recreating.
[ -L "node_modules" ] && rm node_modules

ln -s "$main/node_modules" node_modules
echo "→ symlinked node_modules from $main"
